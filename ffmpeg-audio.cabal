cabal-version:      3.12
name:               ffmpeg-audio
version:            0.1.0.0
synopsis:           FFmpeg binding for stereo, multi-channel, Ambisonics, and IAMF audio encoding
description:
  A Haskell binding to FFmpeg 7.1+ for audio encoding, supporting MP3,
  24-bit multi-channel FLAC, Opus (including Ambisonics mapping families 2/3),
  AAC, E-AC-3, LPCM, and native IAMF / Eclipsa Audio stream groups.
license:            LGPL-2.1-or-later
license-file:       LICENSE
author:             Arjun Shekar Bharadwaj
maintainer:         arjun.s.waj@gmail.com
category:           FFmpeg, Audio, Codec
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        FFmpeg.Audio
        FFmpeg.Audio.PCMBuffer
        FFmpeg.Audio.Metadata
        FFmpeg.Audio.Encoder
        FFmpeg.Audio.IAMF
        FFmpeg.Audio.MP4
        FFmpeg.Audio.Internal.Types
        FFmpeg.Audio.Internal.FFI
        FFmpeg.Audio.Internal.Error
        FFmpeg.Audio.Internal.Codec
        FFmpeg.Audio.Internal.CodecContext
        FFmpeg.Audio.Internal.Frame
        FFmpeg.Audio.Internal.Packet
        FFmpeg.Audio.Internal.Format
        FFmpeg.Audio.Internal.Encoder
        FFmpeg.Audio.Internal.Iamf
        FFmpeg.Audio.Internal.IamfMux
        FFmpeg.Audio.Internal.Image
        FFmpeg.Audio.Internal.StreamGroup
    build-tool-depends: hsc2hs:hsc2hs
    build-depends:
        base ^>=4.20.2.0,
        vector >=0.13 && <0.14,
        bytestring >=0.12 && <0.13,
        directory >=1.3 && <1.4
    pkgconfig-depends: libavcodec, libavformat, libavutil
    hs-source-dirs:   src
    default-language: GHC2024

test-suite ffmpeg-audio-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:
        ErrorSpec
        CodecSpec
        CodecContextSpec
        FrameSpec
        PacketSpec
        FormatSpec
        EncoderSpec
        MultiChannelSpec
        IamfSpec
        MetadataSpec
        Mp4Spec
    build-depends:
        base ^>=4.20.2.0,
        ffmpeg-audio,
        vector >=0.13 && <0.14,
        bytestring >=0.12 && <0.13,
        directory >=1.3 && <1.4,
        process >=1.6 && <1.7
    default-language: GHC2024
